<!doctype html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>Sign in to @@BRAND_NAME@@ comments</title>
</head>
<body style="margin:0; padding:24px 16px; background-color:#f2f5f8; color:#24394b; font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" style="width:100%; max-width:560px; margin:0 auto; border-spacing:0;">
    <tr>
      <td style="padding:28px; background-color:#ffffff; border-radius:8px;">
        <a href="@@WEBSITE_URL@@" style="text-decoration:none;">
          @@LOGO_HTML@@
        </a>
        <h1 style="margin:28px 0 16px; color:#24394b; font-size:24px; line-height:1.3;">Sign in to Journal comments</h1>
        <p style="margin:0 0 16px; font-size:16px; line-height:1.6;">Hello {{.User}},</p>
        <p style="margin:0 0 20px; font-size:16px; line-height:1.6;">Copy this code into the sign-in form on @@BRAND_NAME@@ to finish signing in.</p>
        <div style="padding:16px; background-color:#eef5fb; border:1px solid #c9dcec; border-radius:6px;">
          <p style="margin:0 0 8px; font-size:13px; font-weight:bold;">Your sign-in code</p>
          <p style="margin:0; font-family:Consolas,'Courier New',monospace; font-size:18px; line-height:1.6; word-break:break-all; overflow-wrap:anywhere;">{{.Token}}</p>
        </div>
        <p style="margin:20px 0 0; font-size:14px; line-height:1.6;">If you did not request this code, you can ignore this email.</p>
        <p style="margin:20px 0 0; color:#53687a; font-size:12px; line-height:1.6;">Sent to {{.Address}} for the @@BRAND_NAME@@ Journal.</p>
      </td>
    </tr>
  </table>
</body>
</html>
