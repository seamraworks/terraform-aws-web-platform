[Unit]
Description=@@BRAND_NAME@@ comments
Requires=docker.service nftables.service
After=docker.service network-online.target nftables.service
[Service]
EnvironmentFile=@@CONFIG_DIR@@/deployment.env
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@RUNTIME_DIR@@
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180
[Install]
WantedBy=multi-user.target
